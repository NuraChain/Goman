# Copy to .env for local overrides (never commit .env). Read by the loadConfig block in src/main.ts.
PORT=6000
NODE_ENV=development

# The chain the indexer reads. Defaults match a local node from the contracts
# repo (`npm run node` + `npm run deploy:local` there writes these addresses).
# On a real chain set all four: RPC_URL, CHAIN_ID, FACTORY_ADDRESS, DEPLOY_BLOCK.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
DEPLOY_BLOCK=0
# Where the sqlite index lives and how often the watcher polls for new blocks.
DB_PATH=.data/index.db
POLL_MS=1500
# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js
# Where uploaded market and outcome images are written. Served back from the same origin, so it
# must be writable and must survive a deploy - mount a volume for it in a container.
UPLOAD_DIR=uploads

# The devtools bridge secret (dev only). Generate one:
#   node -e "console.log(crypto.randomUUID())"
# Unset means the bridge simply does not attach.
DEVTOOLS_TOKEN=
