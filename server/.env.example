# Copy to .env for local overrides (never commit .env). Read by the loadConfig block in src/main.ts.
PORT=6000
NODE_ENV=development

# The chain the indexer reads. Defaults match a local node from the contracts
# repo (`npm run node` + `npm run deploy:local` there writes these addresses).
# On a real chain set all four: RPC_URL, CHAIN_ID, FACTORY_ADDRESS, DEPLOY_BLOCK.
# Deployed on Nurachain 1020 at block 846183 (2026-09-12) - the generation with the on-chain
# category registry, pushed payouts and the claim window:
#   factory  0xf0Af7cb99605Ec40F217Dd9c80AF4AF8F86e21c0
#   treasury 0x785090fF1b50EaB9943284FF835eD67a9ea617Ba
#   market   0x5b24628a7bB7d9c7c091650A1737ab94Cc9496b3 (implementation)
#   pool     0x18e35954D826565AD7E1d0bB95c743c883fB9aaf (implementation)
# The index is everything ONE factory emitted, so pointing this at another one starts it over -
# market ids are the registry's own counter and the two would collide.
# Superseded (block 371614, 2026-08-26): factory 0x33fE315c8a7FeA10152dD2b21B5d87936aF9B79d.
# RPC: https://rpc.nurachain.net  Explorer: https://explorer.nurachain.net
RPC_URL=https://rpc.nurachain.net
CHAIN_ID=1020
FACTORY_ADDRESS=0xf0Af7cb99605Ec40F217Dd9c80AF4AF8F86e21c0
DEPLOY_BLOCK=846183
# Where the sqlite index lives and how often the watcher polls for new blocks.
DB_PATH=.data/index.db
POLL_MS=4000
# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js
# Where uploaded market and outcome images are written. Served back from the same origin, so it
# must be writable and must survive a deploy - mount a volume for it in a container.
UPLOAD_DIR=uploads

# The devtools bridge secret (dev only). Generate one:
#   node -e "console.log(crypto.randomUUID())"
# Unset means the bridge simply does not attach.
DEVTOOLS_TOKEN=

# ----------------------------------------------------------------------------------------
# The job key
#
# The ONE key this server holds. Everything else is signed by an admin's own wallet in the
# browser; this exists for the single job that comes due at an hour nobody is watching - a
# market scheduled to open has to come off pause the moment its start time arrives.
#
# It should be its OWN key, not the factory owner's. It needs one grant, from the owner wallet
# in the admin console or a script:
#   factory.grantRole(ADMIN_ROLE, <address>)
# Losing it costs the scheduled openings, which an admin can lift by hand; losing the owner key
# costs the factory and the treasury. Keep it funded - it pays gas for one transaction per
# scheduled opening. Leave it empty and the server runs fine, but a scheduled market stays shut
# until somebody unpauses it themselves.
JOB_PRIVATE_KEY=

# ----------------------------------------------------------------------------------------
# Telegram bot
#
# A private message for every event the indexer records, and the whole database plus the
# uploaded images as one .tar.gz on a timer. Inert without BOTH values, exactly like
# JOB_PRIVATE_KEY - a deployment with no bot runs silently rather than failing to boot.
#
# To get the two values: message @BotFather, /newbot, copy the token; then send your new bot
# any message and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The per-event feed and the backup interval are NOT set here. They are settings an operator
# changes on a running server, so they live in the database and are edited in the admin
# console under Telegram - putting them here meant a redeploy to change a number.
#
# Who may command the bot is set there too. The bot answers /help and /myid to anyone; every
# command that does more - /newmarket, /mine - is limited to the ids on that allowlist.

# Cosmetic: the ticker amounts are written in, and the site root that turns a market's name in
# a message into a link. Leave SITE_URL empty for plain text.
NATIVE_SYMBOL=NURA
SITE_URL=
