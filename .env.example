# Copy to .env at the repo root (never commit .env). ONE file for both halves: the server reads
# it on boot (src/main.ts), Vite reads the VITE_* keys at BUILD time (a change needs a restart).
#
# Every key is required - nothing has a default, and a missing one is a boot or build error that
# names it. A few may be left EMPTY, which is how they are switched off; those say so.

# ========================================================================================
# Server
# ========================================================================================

# Not 6000: that is the X11 port and every browser blocks it (ERR_UNSAFE_PORT in Chrome,
# "This address is restricted" in Firefox), so localhost:6000 never loads even though the
# server is serving. Anything outside the browsers' blocked list is fine.
PORT=4500
# Loopback locally. The container sets 0.0.0.0, because a loopback bind inside it is unreachable
# from the host; `docker run -p 127.0.0.1:4500:4500` publishes it on the host's loopback only.
HOST=127.0.0.1

# The chain the indexer reads.
# Deployed on Nurachain 1020 at block 66806 (2026-10-18, after the chain reset) - the generation with no pause
# or close (a market trades until its lock time) and cancel in place of void; trade fees are
# escrowed until it resolves (refunded on a cancel, no protocol/LP split):
#   factory  0xE869e631465cf85ce0c96260a6651017c4A7612c
#   treasury 0x9200c747508AAe7a973D3a8b90312d257079e906
#   market   0xc4814A17f50df52Cf5774448D253E7b4E81039ee (implementation)
#   pool     0x501c4684713b82Df167dEB7dF43322dfB52F6f4C (implementation)
# The index is everything ONE factory emitted, so pointing this at another one starts it over -
# market ids are the registry's own counter and the two would collide.
# Superseded (all before the 2026-10 chain reset, so none of them has code any more):
# factory 0x8fE06A267a3bc79aC91a97dC840ace0A84d23DbB (block 1193689, 2026-09-24),
# factory 0xe8188D81E628cc234b31410B7A44C90c40FeD77b (block 1187758, 2026-09-24),
# factory 0x6A5277c0BaEc098dEcfdfcE8C91edEfD90855d0B (block 1070651, 2026-09-20),
# factory 0xf0Af7cb99605Ec40F217Dd9c80AF4AF8F86e21c0 (block 846183, 2026-09-12),
# factory 0x33fE315c8a7FeA10152dD2b21B5d87936aF9B79d (block 371614, 2026-08-26).
# RPC: https://rpc.nurachain.net  Explorer: https://explorer.nurachain.net
RPC_URL=https://rpc.nurachain.net
CHAIN_ID=1020
FACTORY_ADDRESS=0xE869e631465cf85ce0c96260a6651017c4A7612c
DEPLOY_BLOCK=66806
# How often the watcher polls for new blocks.
POLL_MS=4000

# The index, in PostgreSQL. Its tables are made on the first start. A password goes in your own
# .env - as `user:password@` before the host - never in this file. The database must be UTF8.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/goman
# Connections the pool may hold. The indexer holds one per chunk; a request, one per read.
DATABASE_POOL_SIZE=10
# Where the server suite makes its throwaway schemas: a database of its own, never the one above.
# The suite reads this one key of the file and nothing else.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/goman_test

# Paths resolve against server/, the directory the server runs in.
# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js
# Where uploaded market and outcome images are written. Served back from the same origin, so it
# must be writable and must survive a deploy - mount a volume for it in a container.
UPLOAD_DIR=uploads

# ----------------------------------------------------------------------------------------
# This server holds NO private key and signs nothing. Every write - deploying a market,
# pausing it, resolving it, resuming one whose start time has arrived - is signed by an
# admin's own wallet in the browser.

# ----------------------------------------------------------------------------------------
# Telegram bot
#
# A private message for every event the indexer records, and the whole index (as SQL psql can
# restore) plus the uploaded images as one .tar.gz on a timer. Leave BOTH empty to run without a
# bot; with either one empty it stays inert.
#
# To get the two values: message @BotFather, /newbot, copy the token; then send your new bot
# any message and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The per-event feed and the backup interval are NOT set here. They are settings an operator
# changes on a running server, so they live in the database and are edited in the admin
# console under Telegram - putting them here meant a redeploy to change a number.
#
# Who may command the bot is set there too. The bot answers /help and /myid to anyone; every
# command that does more - /newmarket, /mine - is limited to the ids on that allowlist.

# Cosmetic: the ticker amounts are written in.
NATIVE_SYMBOL=NURA
# The public origin: a market's name in a bot message links to it, and the client's
# canonical / og:url / og:image tags use it (VITE_SITE_URL below must match). May be empty -
# messages are plain text and those absolute tags are omitted rather than guessed, because a
# canonical pointing at localhost on a live site is worse than none.
SITE_URL=

# Requests per minute per client address, counted over the api and the rendered pages only -
# /assets, robots.txt and the sitemap are never metered, because one budget cannot be right for
# a chain read and for a hashed file with a year of cache time on it.
#
# Raise it where many readers share one address. A mobile carrier can put a whole city behind a
# single NAT, and a budget sized for one household refuses the city; the first thing somebody
# over the line loses is their own JavaScript, which reads as a broken site rather than a refusal.
API_RATE_MAX=600

# ========================================================================================
# Client (Vite, build time)
# ========================================================================================

# The chain the browser talks to - the same one as above.
VITE_RPC_URL=https://rpc.nurachain.net
VITE_CHAIN_ID=1020
VITE_CHAIN_NAME=Nurachain
VITE_CURRENCY_SYMBOL=NURA
VITE_CURRENCY_DECIMALS=18
# May be empty: no explorer, no transaction links.
VITE_EXPLORER_URL=https://explorer.nurachain.net

# The single wallet the admin console opens for. It narrows the on-chain ADMIN_ROLE check,
# it does not replace it.
VITE_ADMIN_ADDRESS=0x2Ef2D5A095Fd5Ecd686d99eD3cd1F9ff91fc3167

# Must match SITE_URL above. May be empty (see there).
VITE_SITE_URL=
