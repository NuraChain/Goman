# Copy to .env for local overrides (never commit .env). Read at BUILD time by Vite, so a
# change needs a dev-server restart. The defaults target a local Hardhat node, which is what
# the contracts repo's `npm run node` starts.

# --- Local Hardhat defaults (npm run node in the contracts repo) ---
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_ID=31337
# VITE_CHAIN_NAME=Local EVM
# VITE_CURRENCY_SYMBOL=ETH
# VITE_CURRENCY_DECIMALS=18
# VITE_EXPLORER_URL=
# VITE_DEPLOY_BLOCK=0

# --- Nurachain 1020 (live) ---
# Deployed at block 1070651 (2026-09-20):
#   factory  0x6A5277c0BaEc098dEcfdfcE8C91edEfD90855d0B
#   market   0x1F1A38BbA2Abca157a6f42BB9c2708BBD2ed18EB (implementation)
#   pool     0x7C59860005EA81dCdF7605931E333e5ab8c52555 (implementation)
#   treasury 0xf2c97C604275E91c350B2D775F0c2699F01efdc2
# RPC: https://rpc.nurachain.net  Explorer: https://explorer.nurachain.net
VITE_RPC_URL=https://rpc.nurachain.net
VITE_CHAIN_ID=1020
VITE_CHAIN_NAME=Nurachain
VITE_CURRENCY_SYMBOL=NURA
VITE_CURRENCY_DECIMALS=18
VITE_EXPLORER_URL=https://explorer.nurachain.net
VITE_DEPLOY_BLOCK=1070651

# The single wallet the admin console opens for. It narrows the on-chain ADMIN_ROLE check,
# it does not replace it. Defaults to the deployer below when unset.
# VITE_ADMIN_ADDRESS=0x4ac0d9300422b408bA2AbF47995C87cF32763712

# The public origin, for canonical / og:url / og:image. MUST match SITE_URL in server/.env.
# Unset, those absolute tags are omitted rather than guessed - a canonical pointing at
# localhost on a live site is worse than none.
VITE_SITE_URL=
