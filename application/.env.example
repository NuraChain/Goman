# Copy to .env for local overrides (never commit .env). Read at BUILD time by Vite, so a
# change needs a dev-server restart. The defaults target a local Hardhat node, which is what
# the contracts repo's `npm run node` starts.

# JSON-RPC endpoint of the Cosmos EVM chain.
VITE_RPC_URL=http://127.0.0.1:8545

# EVM chain id (31337 = local Hardhat).
VITE_CHAIN_ID=31337

# Shown when the wallet is asked to add this network.
VITE_CHAIN_NAME=Local EVM
VITE_CURRENCY_SYMBOL=ETH
VITE_CURRENCY_DECIMALS=18

# Block explorer base URL; leave empty to disable transaction links.
VITE_EXPLORER_URL=

# First block the admin activity scan reads from (set to the factory's deploy block on a
# real chain so getLogs never walks history that predates the system).
VITE_DEPLOY_BLOCK=0
