import { createMemoryHistory, createRouter, RouterProvider, Routes, type LoaderHandoff } from 'azerothjs';

import { routes } from './routes.ts';

import ErrorPage from './pages/error.page.azeroth';
import NotFoundPage from './pages/not-found.page.azeroth';

import Header from './components/layout/header.azeroth';
import Footer from './components/layout/footer.azeroth';
import TabBar from './components/layout/tab-bar.azeroth';
import AuthSheet from './components/layout/auth-sheet.azeroth';
import MenuSheet from './components/layout/menu-sheet.azeroth';
import LangSheet from './components/layout/lang-sheet.azeroth';
import Toasts from './components/ui/toasts.azeroth';

// The app frame: one viewport-high column where the SCROLL REGION is the inner div, not
// the window - so the scrollbar ends exactly where the tab bar begins, and the tab bar owns
// the full screen width below it. Inside the scroll region a min-h-full column pins the
// footer to the bottom of short pages. overflow-x-hidden is the belt-and-braces guard: no
// stray wide child may ever hand the page a horizontal scrollbar.
//
// `url` drives a memory history instead of the browser's, which is how a server render and a
// test both mount a route without touching history - the AppFrame/App split the React version
// needed for that is gone. `handoff` carries the loader data the server already fetched, so
// hydration adopts it rather than fetching the same thing again.
export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url === undefined ? undefined : createMemoryHistory(props.url),
        initialLoaderData: props.handoff
    });

    <RouterProvider router={ router }>
        <div class="flex h-dvh flex-col bg-surface text-text">
            <div class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden">
                <div class="flex min-h-full flex-col">
                    <Header />
                    <main class="flex-1 pb-6">
                        { /* Inside the boundary: a page that throws swaps in the error page
                             instead of unmounting the tree to a blank screen. */ }
                        <ErrorBoundary fallback={ (_error, reset) => <ErrorPage reset={ reset } /> }>
                            <Routes fallback={ () => <NotFoundPage /> } />
                        </ErrorBoundary>
                    </main>
                    <Footer />
                </div>
            </div>
            <TabBar />
            <AuthSheet />
            <MenuSheet />
            <LangSheet />
            <Toasts />
        </div>
    </RouterProvider>
}
