import { useHead } from 'azerothjs';
import { useSearchParams } from '../lib/search-params.ts';

import type { IconName } from '../icons/registry.ts';

import { useLocale } from '../stores/locale.store.ts';
import { useChrome } from '../stores/chrome.store.ts';
import { useSession } from '../stores/session.store.ts';
import { useAdmin } from '../stores/admin.store.ts';
import { useConfig } from '../stores/config.store.ts';
import { useCreateDraft, draftFromQuery, isDraftParam } from '../stores/create-draft.store.ts';

import Icon from '../icons/icon.azeroth';

import Button from '../components/ui/button.azeroth';
import EmptyState from '../components/ui/empty-state.azeroth';
import Skeleton from '../components/ui/skeleton.azeroth';

import AdminStats from '../components/admin/admin-stats.azeroth';
import MarketTable from '../components/admin/market-table.azeroth';
import CategoryTable from '../components/admin/category-table.azeroth';
import CreateMarketForm from '../components/admin/create-market-form.azeroth';
import ProposalTable, { MyProposals } from '../components/admin/proposal-table.azeroth';
import TreasuryCard from '../components/admin/treasury-card.azeroth';
import ConfigCard from '../components/admin/config-card.azeroth';
import SignersCard from '../components/admin/signers-card.azeroth';
import AccessCard from '../components/admin/access-card.azeroth';
import TelegramCard from '../components/admin/telegram-card.azeroth';
import ActivityFeed from '../components/admin/activity-feed.azeroth';

// The operator console. Lists and stats come from the indexer (server-side search/filter/
// pagination - instant at a 100k-market registry); the role gate and every write go
// straight to the chain through the connected wallet. Gated on the factory's ADMIN_ROLE.
export default component Admin()
{
    const { t } = useLocale();

    useHead({ title: () => t('admin.title') });
    const chrome = useChrome();
    const session = useSession();
    const admin = useAdmin();
    const config = useConfig();

    // The chain moves while this page is away; every visit re-pulls the read model. It runs
    // on MOUNT, not in the render body - a refresh during render bumps the store, which
    // re-renders, which refreshes again.
    mount
    {
        admin.refresh();
        // oxlint-disable-next-line react/exhaustive-deps;
    }

    // The open section lives in the URL, not in component state: `/admin?section=create` is
    // what a create link points at, and a console tab worth sending someone is a console tab
    // worth reloading onto.
    const [params, setParams] = useSearchParams();

    // A create link carries the whole draft in its query. It is consumed ONCE, on arrival: the
    // fields live in the draft store from then on, and leaving them in the address bar would
    // re-seed a form that has since been edited.
    mount
    {
        const seed = draftFromQuery(params());
        if (seed !== null)
        {
            useCreateDraft().load(seed);
            const rest = new URLSearchParams(params());
            for (const key of [...rest.keys()])
            {
                if (isDraftParam(key))
                {
                    rest.delete(key);
                }
            }
            setParams(rest, { replace: true });
        }
        // oxlint-disable-next-line react/exhaustive-deps;
    }

    derived sections = [
        { id: 'markets', label: t('admin.sectionMarkets'), icon: 'chart' as IconName },
        { id: 'categories', label: t('admin.sectionCategories'), icon: 'tag' as IconName },
        { id: 'create', label: t('admin.sectionCreate'), icon: 'plus' as IconName },
        { id: 'proposals', label: t('admin.sectionProposals'), icon: 'send' as IconName },
        { id: 'treasury', label: t('admin.sectionTreasury'), icon: 'wallet' as IconName },
        { id: 'factory', label: t('admin.sectionFactory'), icon: 'settings' as IconName },
        { id: 'access', label: t('admin.sectionAccess'), icon: 'user' as IconName },
        { id: 'telegram', label: t('admin.sectionTelegram'), icon: 'brand-telegram' as IconName },
        { id: 'activity', label: t('admin.sectionActivity'), icon: 'activity' as IconName }
    ];

    // An unknown section name is a stale or hand-typed link, not a blank console.
    derived asked = params().get('section') ?? '';
    derived section = sections.some((entry) => entry.id === asked) ? asked : 'markets';

    const setSection = (id: string): void =>
    {
        const next = new URLSearchParams(params());
        next.set('section', id);
        // Replaced, not pushed: Back should leave the console, not walk back through every
        // tab the operator glanced at.
        setParams(next, { replace: true });
    };

    <Switch>
        <Match when={ !session.connected() }>
            <section class="shell py-5">
                <EmptyState
                    icon="wallet"
                    tone="brand"
                    size="lg"
                    heading
                    title={ t('profile.connectTitle') }
                    hint={ t('admin.deniedHint') }
                >
                    <Button onClick={ () => chrome.openAuth() }>{ t('auth.title') }</Button>
                </EmptyState>
            </section>
        </Match>
        <Match when={ config.error() !== null }>
            <section class="shell py-5">
                <EmptyState
                    icon="globe"
                    size="lg"
                    heading
                    title={ t('admin.noDeployment') }
                    hint={ t('admin.noDeploymentHint') }
                />
            </section>
        </Match>
        <Match when={ admin.checking() || (config.loading() && config.data() === undefined) }>
            <section class="shell py-5">
                <Skeleton class="h-64 rounded-card" />
            </section>
        </Match>
        <Match when={ !admin.isAdmin() && (admin.invited.loading()) }>
            <section class="shell py-5">
                <Skeleton class="h-64 rounded-card" />
            </section>
        </Match>
        <Match when={ !admin.isAdmin() && (admin.invited.data()?.allowed === true) }>
            <section class="shell py-5">
                <header class="mb-5 motion-safe:animate-rise">
                    <h1 class="text-xl font-bold tracking-tight sm:text-2xl">{ t('admin.contributorTitle') }</h1>
                    <p class="text-[13px] leading-relaxed text-muted">{ t('admin.contributorHint') }</p>
                </header>
                <CreateMarketForm canDeploy={ false } />
                { /* Under the form rather than above it: what this page is FOR is writing
                    the next market down. A verdict already given is a thing to scroll to,
                    and an empty list renders nothing at all. */ }
                <div class="mx-auto mt-5 max-w-3xl">
                    <MyProposals address={ session.address() } />
                </div>
            </section>
        </Match>
        <Match when={ !admin.isAdmin() }>
            { /* // Invited, not promoted: the create form and nothing else of the console. The form
                    // knows it cannot deploy and files a proposal in place of signing one. */ }
            <section class="shell py-5">
                <EmptyState
                    icon="alert"
                    tone="danger"
                    size="lg"
                    heading
                    title={ t('admin.denied') }
                    hint={ t('admin.deniedHint') }
                />
            </section>
        </Match>
        <Match when={ true }>
            <section class="shell py-5">
                <header class="mb-5 flex flex-wrap items-center gap-3 motion-safe:animate-rise">
                    <div class="min-w-0 flex-1">
                        <h1 class="text-xl font-bold tracking-tight sm:text-2xl">{ t('admin.title') }</h1>
                        <p class="text-[13px] text-muted">{ t('admin.subtitle') }</p>
                    </div>
                    <Show when={ section !== 'create' }>
                        <Button variant="primary" size="sm" icon="plus" onClick={ () => setSection('create') }>
                            { t('admin.create') }
                        </Button>
                    </Show>
                </header>

                <div class="mb-6">
                    <AdminStats />
                </div>

                <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
                    <nav
                        class="rail rail-bleed rail-fade min-w-0 gap-2 lg:sticky lg:top-20 lg:flex-col lg:gap-1"
                        aria-label={ t('admin.title') }
                    >
                        <For each={ sections } key={ (entry) => entry.id } let={ entry }>
                            <button
                                class={
                                    section === entry.id
                                        ? 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control bg-overlay px-3.5 text-[14px] font-bold text-text lg:w-full'
                                        : 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control px-3.5 text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text lg:w-full'
                                }
                                type="button"
                                onClick={ () => setSection(entry.id) }
                            >
                                <Icon name={ entry.icon } size={ 17 } />
                                <span>{ entry.label }</span>
                            </button>
                        </For>
                    </nav>

                    <div class="min-w-0 motion-safe:animate-fade">
                        <Show when={ section === 'markets' }>
                            <MarketTable />
                        </Show>
                        <Show when={ section === 'categories' }>
                            <CategoryTable />
                        </Show>
                        <Show when={ section === 'create' }>
                            <CreateMarketForm />
                        </Show>
                        <Show when={ section === 'proposals' }>
                            <ProposalTable />
                        </Show>
                        <Show when={ section === 'treasury' }>
                            <div class="mx-auto max-w-xl">
                                <TreasuryCard />
                            </div>
                        </Show>
                        <Show when={ section === 'factory' }>
                            <div class="mx-auto flex max-w-xl flex-col gap-6">
                                <ConfigCard />
                                <SignersCard />
                            </div>
                        </Show>
                        <Show when={ section === 'access' }>
                            <div class="mx-auto max-w-xl">
                                <AccessCard />
                            </div>
                        </Show>
                        <Show when={ section === 'telegram' }>
                            <div class="mx-auto max-w-xl">
                                <TelegramCard />
                            </div>
                        </Show>
                        <Show when={ section === 'activity' }>
                            <ActivityFeed />
                        </Show>
                    </div>
                </div>
            </section>
        </Match>
    </Switch>

}
