import { createResource, useHead } from 'azerothjs';
import { client } from '../api.ts';

import { useLocale } from '../stores/locale.store.ts';

import CategoryRail from '../components/market/category-rail.azeroth';
import MarketCard from '../components/market/market-card.azeroth';
import FeaturedRail from '../components/market/featured-rail.azeroth';
import Skeleton from '../components/ui/skeleton.azeroth';
import Button from '../components/ui/button.azeroth';
import Pagination from '../components/ui/pagination.azeroth';
import EmptyState from '../components/ui/empty-state.azeroth';
import { MARKET_GRID } from '../components/ui/variants.ts';

const PAGE_SIZE = 12;

export default component Home()
{
    const { t } = useLocale();

    // Named in the reader's own language, in the FIRST response: this page renders on
    // the server precisely so a crawler and a reader see the same document.
    useHead({
        title: () => t('app.tagline'),
        meta: [{ name: 'description', content: () => t('app.tagline') }]
    });

    state category = 'all';
    state page = 1;

    const featured = createResource(
        () => 'featured',
        () => client.markets.list({ query: { featured: true, limit: 8 } })
    );

    const markets = createResource(
        () => `${ category }|${ page }`,
        (key: string) =>
        {
            const [activeCategory = 'all', activePage = '1'] = key.split('|');
            return client.markets.list({
                query: {
                    ...(activeCategory === 'all' ? {} : { category: activeCategory }),
                    sort: 'volume',
                    page: Number(activePage),
                    limit: PAGE_SIZE
                }
            });
        }
    );

    derived data = markets.data();

    <section class="shell py-5">
        <Show when={ markets.loading() && data === undefined }>
            <>
                <div class="mb-8 flex gap-4 overflow-hidden">
                    <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
                    <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
                    <Skeleton class="h-64 w-[19.5rem] shrink-0 rounded-card sm:w-[22rem]" />
                </div>
                <div class={ MARKET_GRID }>
                    <Skeleton class="h-44 rounded-card" />
                    <Skeleton class="h-44 rounded-card" />
                    <Skeleton class="h-44 rounded-card" />
                    <Skeleton class="h-44 rounded-card" />
                </div>
            </>
        </Show>

        <Show when={ !markets.loading() && markets.error() !== null }>
            <EmptyState icon="alert" tone="danger" hint={ t('common.error') }>
                <Button variant="outline" onClick={ () => markets.refetch() }>
                    { t('common.retry') }
                </Button>
            </EmptyState>
        </Show>

        <Show when={ data } let={ data }>
            <div>
                <FeaturedRail markets={ featured.data()?.rows ?? [] } />

                <h2 class="mb-3 text-lg font-bold tracking-tight">{ t('home.allMarkets') }</h2>
                <div class="mb-3">
                    <CategoryRail
                        selected={ category }
                        onSelect={ (next) =>
                        {
                            category = next;
                            page = 1;
                        } }
                    />
                </div>

                <Show when={ data.rows.length > 0 } fallback={
                    category === 'all'
                        /*
                         * NOTHING is narrowed, so an empty list is an empty INDEX, not a search that
                         * found nothing. The other branch tells a first visitor to a fresh
                         * deployment that their word matched nothing and offers to clear a filter
                         * they never set - a confident statement about the world made without
                         * looking. No button either: there is nothing here to clear.
                         */
                        ? <EmptyState icon="search" title={ t('browse.emptyIndex') } hint={ t('browse.emptyIndexHint') } />
                        : <EmptyState icon="search" title={ t('browse.noResults') } hint={ t('browse.noResultsHint') }>
                            <Button variant="outline" icon="flame" onClick={ () => category = 'all' }>
                                { t('categories.all') }
                            </Button>
                        </EmptyState>
                    }>
                    <>
                        <div class={ MARKET_GRID }>
                            <For each={ data.rows } key={ (market) => market.id } let={ market }>
                                <div class="contents">
                                    <MarketCard market={ market } />
                                </div>
                            </For>
                        </div>
                        <div class="mt-6">
                            <Pagination page={ data.page } pages={ data.pages } onChange={ (next) => page = next } />
                        </div>
                    </>
                </Show>
            </div>
        </Show>
    </section>
}
