import { createResource, styleMap, useHead } from 'azerothjs';
import { client, PERIODS, type Period } from '../api.ts';
import { pageOf } from '../lib/paged.ts';
import { shortAddress, addressGradient } from '../lib/wallet.ts';

import { useLocale } from '../stores/locale.store.ts';
import { useSession } from '../stores/session.store.ts';

import { formatVolume, formatSigned } from '../i18n/format.ts';

import Icon from '../icons/icon.azeroth';

import Tabs from '../components/ui/tabs.azeroth';
import SkeletonList from '../components/ui/skeleton-list.azeroth';
import Pagination from '../components/ui/pagination.azeroth';
import Tooltip from '../components/ui/tooltip.azeroth';
import EmptyState from '../components/ui/empty-state.azeroth';
import { cardClass } from '../components/ui/variants.ts';

const PAGE_SIZE = 10;

export default component Leaderboard()
{
    const { t, lang } = useLocale();
    const session = useSession();

    // Named in the reader's own language, in the FIRST response: this page renders on
    // the server precisely so a crawler and a reader see the same document.
    useHead({
        title: () => `${ t('leaderboard.title') } - Goman`,
        meta: [{ name: 'description', content: () => t('leaderboard.emptyHint') }]
    });

    state period: Period = 'week';
    state page = 1;

    const rows = createResource(
        () => period,
        (active: Period) => client.leaderboard.list({ query: { period: active } })
    );

    derived periodTabs = PERIODS.map((entry) => ({ id: entry, label: t(`leaderboard.${ entry }` as 'leaderboard.day') }));
    derived paged = pageOf(rows.data() ?? [], page, PAGE_SIZE);

    <section class="shell py-5">
        <div class="mx-auto max-w-3xl">
            <h1 class="mb-1 flex items-center gap-2 text-2xl font-bold tracking-tight motion-safe:animate-rise">
                <Icon name="trophy" size={ 22 } class="text-gold" />
                { t('leaderboard.title') }
            </h1>

            <div class="mb-4 mt-4">
                <Tabs
                    tabs={ periodTabs }
                    active={ period }
                    onChange={ (next) =>
                    {
                        period = next as Period;
                        page = 1;
                    } }
                />
            </div>

            <Show when={ rows.loading() }>
                <SkeletonList count={ 5 } height="h-14" radius="card" gap="md" />
            </Show>

            <Show when={ !rows.loading() && paged.rows.length === 0 }>
                <EmptyState icon="trophy" title={ t('leaderboard.empty') } hint={ t('leaderboard.emptyHint') } />
            </Show>

            <Show when={ !rows.loading() && paged.rows.length > 0 }>
                <>
                    <ol class="grid grid-cols-1 gap-2.5">
                        <For each={ paged.rows } key={ (row) => `${ period }-${ row.rank }` } let={ row }>
                            <li class="motion-safe:animate-rise">
                                <div
                                    class={ `${ cardClass({ tone: row.address === session.address().toLowerCase() ? 'brand' : 'line', padding: 'snug' }) } flex items-center gap-3` }
                                >
                                    <Show when={ row.rank <= 3 } fallback={
                                        <span
                                            class="flex h-9 w-9 shrink-0 items-center justify-center"
                                            aria-hidden="true"
                                        >
                                            <span class="nums text-[14px] font-bold text-faint">
                                                { row.rank }
                                            </span>
                                        </span>
                                        }>
                                        <Tooltip label={ `${ t('leaderboard.rank') } ${ row.rank }` }>
                                            <span
                                                class="flex h-9 w-9 shrink-0 items-center justify-center"
                                                role="img"
                                                aria-label={ `${ t('leaderboard.rank') } ${ row.rank }` }
                                            >
                                                <Show when={ row.rank === 1 }>
                                                    <Icon name="crown" size={ 22 } class="text-gold" />
                                                </Show>
                                                <Show when={ (row.rank === 2 || row.rank === 3) }>
                                                    <Icon
                                                        name="medal"
                                                        size={ 20 }
                                                        class={ row.rank === 2 ? 'text-muted' : 'text-gold' }
                                                    />
                                                </Show>
                                            </span>
                                        </Tooltip>
                                    </Show>
                                    <span
                                        class="h-9 w-9 shrink-0 overflow-hidden rounded-full ring-2 ring-line"
                                        style={ styleMap({ background: addressGradient(row.address) }) }
                                        aria-hidden="true"
                                    ></span>
                                    <span class="min-w-0 flex-1">
                                        <span class="nums latin-nums block truncate text-[14px] font-bold">
                                            <bdi dir="ltr">{ shortAddress(row.address) }</bdi>
                                        </span>
                                        <span class="nums block text-[12px] text-faint">
                                            { t('market.volume') }: { formatVolume(row.volume, lang()) }
                                        </span>
                                    </span>
                                    <span
                                        class={
                                            row.profit >= 0
                                                ? 'nums shrink-0 text-[15px] font-bold text-yes'
                                                : 'nums shrink-0 text-[15px] font-bold text-no'
                                        }
                                    >
                                        { formatSigned(row.profit, lang()) }
                                    </span>
                                </div>
                            </li>
                        </For>
                    </ol>
                    <div class="mt-5">
                        <Pagination page={ paged.current } pages={ paged.pages } onChange={ (next) => page = next } />
                    </div>
                </>
            </Show>
        </div>
    </section>
}
