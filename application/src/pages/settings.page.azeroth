import { styleMap } from 'azerothjs';
import { readSetting, writeSetting } from '../lib/storage.ts';
import { shortAddress, addressGradient } from '../lib/wallet.ts';
import { copyText } from '../lib/clipboard.ts';

import { useLocale } from '../stores/locale.store.ts';
import { usePreferences } from '../stores/preferences.store.ts';
import type { CalendarMode } from '../i18n/calendar.ts';
import { useTheme } from '../stores/theme.store.ts';
import { useSession } from '../stores/session.store.ts';
import { useToasts } from '../stores/toasts.store.ts';

import { LANGS } from '../i18n/langs.ts';

import Icon from '../icons/icon.azeroth';
import type { IconName } from '../icons/registry.ts';

import Card from '../components/ui/card.azeroth';
import Chip from '../components/ui/chip.azeroth';
import Flag from '../components/ui/flag.azeroth';
import Select from '../components/ui/select.azeroth';
import SettingRow from '../components/ui/setting-row.azeroth';
import Toggle from '../components/ui/toggle.azeroth';

// Settings: desktop = sidebar sections, mobile = a horizontal section rail. Identity is the
// wallet (there is no username/email account behind it); the preferences are real and
// persist locally.
export default component Settings()
{
    const { t, lang, setLang } = useLocale();
    const { oddsMode, setOddsMode, calendar, setCalendar } = usePreferences();
    const appearance = useTheme();
    const session = useSession();
    const toasts = useToasts();

    const saved = (): void =>
    {
        toasts.push('success', t('toast.saved'), 'check');
    };

    const copyAddress = async (): Promise<void> =>
    {
        if (await copyText(session.address()))
        {
            toasts.push('success', t('toast.addressCopied'), 'copy');
            return;
        }
        toasts.push('error', t('toast.copyFailed'), 'alert');
    };

    state section = 'account';
    state confirmTrades = 
        (readSetting('goman.confirm-trades') ?? readSetting('auctionhouse.confirm-trades')) !== 'off'
    ;
    state pushResolve = 
        (readSetting('goman.push-resolve') ?? readSetting('auctionhouse.push-resolve')) !== 'off'
    ;

    derived sections = [
        { id: 'account', label: t('settings.account'), icon: 'settings' as IconName },
        { id: 'trading', label: t('settings.trading'), icon: 'chart' as IconName },
        { id: 'notifications', label: t('settings.notifications'), icon: 'bell' as IconName }
    ];

    <section class="shell py-5">
        <div class="mx-auto max-w-5xl">
            <h1 class="mb-5 text-2xl font-bold tracking-tight motion-safe:animate-rise">
                { t('settings.title') }
            </h1>

            <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[14rem_minmax(0,1fr)]">
                <nav
                    class="rail rail-bleed rail-fade min-w-0 gap-2 lg:flex-col lg:gap-1"
                    aria-label={ t('settings.title') }
                >
                    <For each={ sections } key={ (entry) => entry.id } let={ entry }>
                        <button
                            class={
                                section === entry.id
                                    ? 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control bg-overlay px-3.5 text-[14px] font-bold text-text lg:w-full'
                                    : 'flex h-11 shrink-0 cursor-pointer items-center gap-2.5 rounded-control px-3.5 text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text lg:w-full'
                            }
                            type="button"
                            onClick={ () => section = entry.id }
                        >
                            <Icon name={ entry.icon } size={ 17 } />
                            <span>{ entry.label }</span>
                        </button>
                    </For>
                </nav>

                <div class="min-w-0">
                    <Show when={ section === 'account' }>
                        <div class="grid grid-cols-1 gap-4 motion-safe:animate-fade">
                            <Show when={ session.connected() }>
                                <Card class="flex items-center gap-4">
                                    <span
                                        class="h-14 w-14 shrink-0 overflow-hidden rounded-full ring-2 ring-line"
                                        style={ styleMap({ background: addressGradient(session.address()) }) }
                                        aria-hidden="true"
                                    ></span>
                                    { /* Both lines belong to the avatar beside them, so both stay
                                         in the page's direction. `dir` on the address itself
                                         aligned it to the left and left an RTL card with its
                                         address at one end and the wallet's name at the other;
                                         <bdi> keeps the run Latin without moving the line. */ }
                                    <div class="min-w-0 flex-1">
                                        <p class="nums latin-nums font-bold">
                                            <bdi dir="ltr">{ shortAddress(session.address()) }</bdi>
                                        </p>
                                        <p class="truncate text-[13px] text-muted">
                                            <bdi>{ session.wallet() ?? '' }</bdi>
                                        </p>
                                    </div>
                                    <button
                                        class="flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-control border border-line px-3 text-[13px] font-semibold text-muted transition-colors duration-200 hover:text-text"
                                        type="button"
                                        onClick={ () => void copyAddress() }
                                    >
                                        <Icon name="copy" size={ 14 } />
                                        { t('common.copy') }
                                    </button>
                                </Card>
                            </Show>
                            <Card>
                                <SettingRow wrap label={ t('nav.language') }>
                                    <div class="flex flex-wrap gap-2">
                                        <For each={ LANGS } key={ (row) => row.code } let={ row }>
                                            <span lang={ row.code }>
                                                <Chip
                                                    compact
                                                    selected={ lang() === row.code }
                                                    onSelect={ () =>
                                                    {
                                                        setLang(row.code);
                                                        saved();
                                                    } }
                                                >
                                                    <Flag code={ row.flag } />
                                                    { row.endonym }
                                                </Chip>
                                            </span>
                                        </For>
                                    </div>
                                </SettingRow>
                                <SettingRow divided wrap label={ t('nav.theme') }>
                                    <div class="flex gap-2">
                                        <Chip
                                            compact
                                            icon="moon"
                                            selected={ appearance.theme() === 'dark' }
                                            onSelect={ () =>
                                            {
                                                appearance.setTheme('dark');
                                                saved();
                                            } }
                                        >
                                            { t('nav.themeDark') }
                                        </Chip>
                                        <Chip
                                            compact
                                            icon="sun"
                                            selected={ appearance.theme() === 'light' }
                                            onSelect={ () =>
                                            {
                                                appearance.setTheme('light');
                                                saved();
                                            } }
                                        >
                                            { t('nav.themeLight') }
                                        </Chip>
                                    </div>
                                </SettingRow>
                            </Card>
                        </div>
                    </Show>

                    <Show when={ section === 'trading' }>
                        <Card animate="fade">
                            <SettingRow label={ t('settings.oddsFormat') }>
                                <Select
                                    options={ [
                                        { id: 'price', label: t('settings.oddsPrice') },
                                        { id: 'percent', label: t('settings.oddsPercent') }
                                    ] }
                                    value={ oddsMode() }
                                    onChange={ (next) =>
                                    {
                                        setOddsMode(next as 'price' | 'percent');
                                        saved();
                                    } }
                                    label={ t('settings.oddsFormat') }
                                />
                            </SettingRow>
                            <SettingRow divided label={ t('settings.calendar') } hint={ t('settings.calendarHint') }>
                                <Select
                                    options={ [
                                        { id: 'auto', label: t('settings.calendarAuto') },
                                        { id: 'gregorian', label: t('settings.calendarGregorian') },
                                        { id: 'jalali', label: t('settings.calendarJalali') }
                                    ] }
                                    value={ calendar() }
                                    onChange={ (next) =>
                                    {
                                        setCalendar(next as CalendarMode);
                                        saved();
                                    } }
                                    label={ t('settings.calendar') }
                                />
                            </SettingRow>
                            <SettingRow
                                divided
                                label={ t('settings.confirmTrades') }
                                hint={ t('settings.confirmTradesHint') }
                            >
                                <Toggle
                                    checked={ confirmTrades }
                                    label={ t('settings.confirmTrades') }
                                    onChange={ (next) =>
                                    {
                                        confirmTrades = next;
                                        writeSetting('goman.confirm-trades', next ? 'on' : 'off');
                                        saved();
                                    } }
                                />
                            </SettingRow>
                        </Card>
                    </Show>

                    <Show when={ section === 'notifications' }>
                        <Card animate="fade">
                            <SettingRow label={ t('settings.pushResolve') }>
                                <Toggle
                                    checked={ pushResolve }
                                    label={ t('settings.pushResolve') }
                                    onChange={ (next) =>
                                    {
                                        pushResolve = next;
                                        writeSetting('goman.push-resolve', next ? 'on' : 'off');
                                        saved();
                                    } }
                                />
                            </SettingRow>
                        </Card>
                    </Show>
                </div>
            </div>
        </div>
    </section>
}
