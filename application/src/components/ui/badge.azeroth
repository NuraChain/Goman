import type { MountNode } from 'azerothjs';

import Icon from '../../icons/icon.azeroth';
import type { IconName } from '../../icons/registry.ts';

import { badgeClass, type BadgeTone } from './variants.ts';

export default component Badge(props: { tone?: BadgeTone; icon?: IconName; children?: MountNode })
{
    <span class={ badgeClass(props.tone ?? 'muted') }>
        <Show when={ props.icon } let={ icon }>
            <Icon name={ icon } size={ 12 } />
        </Show>
        { props.children }
    </span>
}
