import type { MountNode } from 'azerothjs';

import { cardClass, type CardTone, type CardPadding, type CardAnimate } from './variants.ts';

// The card surface as a component, for the common block case. A site that must be a
// different element (article, li, aside, Link) calls cardClass() directly instead.
export default component Card(props: {
    tone?: CardTone;
    padding?: CardPadding;
    interactive?: boolean;
    animate?: CardAnimate;
    class?: string;
    children?: MountNode;
})
{
    derived classes = cardClass({
        tone: props.tone,
        padding: props.padding,
        interactive: props.interactive,
        animate: props.animate
    });
    <div class={ `${ classes }${ props.class !== undefined ? ` ${ props.class }` : '' }` }>
        { props.children }
    </div>
}
