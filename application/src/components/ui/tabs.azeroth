import { tabClass } from './variants.ts';

export default component Tabs(props: {
    tabs: Array<{ id: string; label: string }>;
    active: string;
    onChange: (id: string) => void;
})
{
    <div class="flex items-center gap-5 border-b border-line" role="tablist">
        <For each={ props.tabs } key={ (tab) => tab.id } let={ tab }>
            <button
                class={ tabClass(props.active === tab.id) }
                type="button"
                role="tab"
                aria-selected={ props.active === tab.id }
                onClick={ () => props.onChange(tab.id) }
            >
                { tab.label }
            </button>
        </For>
    </div>
}
