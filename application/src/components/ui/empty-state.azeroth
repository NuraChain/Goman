import type { MountNode } from 'azerothjs';

import type { IconName } from '../../icons/registry.ts';
import Icon from '../../icons/icon.azeroth';

// The centered empty/error state: icon circle, title, hint, one action. `heading` renders
// the title as the page's h1 for full-page gates (the signed-out portfolio).
export default component EmptyState(props: {
    icon: IconName;
    tone?: 'muted' | 'brand' | 'danger';
    size?: 'md' | 'lg';
    title?: string;
    hint?: string;
    heading?: boolean;
    children?: MountNode;
})
{
    derived tone =
        props.tone === 'brand'
            ? 'bg-brand-soft text-brand'
            : props.tone === 'danger'
                ? 'bg-no-soft text-no'
                : 'bg-overlay text-muted';
    derived circleSize = props.size === 'lg' ? 'h-14 w-14' : 'h-12 w-12';
    derived circle = `mx-auto mb-4 flex ${ circleSize } items-center justify-center rounded-sheet ${ tone }`;

    <div
        class={
            props.size === 'lg'
                ? 'mx-auto max-w-sm py-20 text-center motion-safe:animate-rise'
                : 'mx-auto max-w-sm py-14 text-center motion-safe:animate-rise'
        }
    >
        <span class={ circle }>
            <Icon name={ props.icon } size={ props.size === 'lg' ? 26 : 22 } />
        </span>
        { props.title !== undefined &&
            (props.heading === true ? (
                <h1 class="mb-1 text-xl font-bold tracking-tight">{ props.title }</h1>
            ) : (
                <p class="mb-1 font-bold">{ props.title }</p>
            )) }
        <Show when={ props.hint } let={ hint }>
            <p class="mb-5 text-[14px] text-muted">{ hint }</p>
        </Show>
        { props.children }
    </div>
}
