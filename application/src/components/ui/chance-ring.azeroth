import { createRef, styleMap } from 'azerothjs';
// The probability ring on market cards: an SVG arc that draws in on mount and animates
// between prices. Purely decorative - the number beside it carries the value, so the ring
// is aria-hidden and never the only signal (the color-alone defect class).
export default component ChanceRing(props: { share: number; size?: number })
{
    derived size = props.size ?? 44;
    const stroke = 4;
    derived radius = (size - stroke) / 2;
    derived circumference = 2 * Math.PI * radius;

    const arc = createRef<SVGCircleElement>();

    // First paint shows an empty ring; the next frame animates to the real share, and any
    // later share change rides the same transition.
    effect (props.share, circumference)
    {
        const target = `${ Math.max(0, Math.min(1, props.share)) * circumference } ${ circumference }`;
        const frame = requestAnimationFrame(() => arc.current?.setAttribute('stroke-dasharray', target));
        cleanup
        {
            cancelAnimationFrame(frame);
        }
    }

    <svg
        width={ size }
        height={ size }
        viewBox={ `0 0 ${ size } ${ size }` }
        aria-hidden="true"
        style={ styleMap({ transform: 'rotate(-90deg)' }) }
    >
        <circle cx={ size / 2 } cy={ size / 2 } r={ radius } fill="none" stroke="var(--line)" stroke-width={ stroke } />
        <circle
            ref={ arc }
            cx={ size / 2 }
            cy={ size / 2 }
            r={ radius }
            fill="none"
            stroke="var(--brand)"
            stroke-width={ stroke }
            stroke-linecap="round"
            stroke-dasharray={ `0 ${ circumference }` }
            style={ styleMap({ transition: 'stroke-dasharray var(--motion-slow) var(--ease-out)' }) }
        />
    </svg>
}
