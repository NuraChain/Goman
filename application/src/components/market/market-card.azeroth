import { Link } from 'azerothjs';

import { marketPath, type Market } from '../../api.ts';

import { hasEnded, isBinary, leadPrice } from '../../lib/market.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { usePreferences } from '../../stores/preferences.store.ts';
import { useCategories } from '../../stores/categories.store.ts';

import { formatOdds, formatOddsSet, formatVolume, formatDateTimeShort } from '../../i18n/format.ts';

import Icon from '../../icons/icon.azeroth';

import ChanceRing from '../ui/chance-ring.azeroth';
import Tooltip from '../ui/tooltip.azeroth';
import { cardClass } from '../ui/variants.ts';
import FavoriteButton from './favorite-button.azeroth';
import OutcomePair from './outcome-pair.azeroth';
import OutcomeRow from './outcome-row.azeroth';
import MarketAvatar from './market-avatar.azeroth';

// The market card - the product's atom. THREE shapes, chosen by the market's own shape:
//   binary        one collapsed Yes/No leg -> chance ring + a full-width Yes/No pair
//   head-to-head  exactly two named sides  -> a row per side, then two buttons NAMED for them
//   list          three or more candidates -> a row per candidate with its own Yes/No
// Fixes the reference site's defects by contract: price on every button, resolve date and
// volume always visible, one odds convention. The meta row holds at most three items so it
// can never wrap; trending/featured are icon marks, not row-crowding badges.
export default component MarketCard(props: { market: Market })
{
    const { t, lang, text } = useLocale();
    const { oddsMode, calendarSystem } = usePreferences();
    const categories = useCategories();

    derived detailPath = marketPath(props.market);

    // Apportioned across the WHOLE outcome set, then read per row - rounding each candidate
    // on its own prints a set that does not add up to 100.
    derived outcomeOdds = formatOddsSet(
        props.market.outcomes.map((entry) => entry.price),
        lang(),
        oddsMode()
    );

    derived binary = isBinary(props.market);
    derived duel = !binary && props.market.outcomes.length === 2;
    derived ended = hasEnded(props.market);
    derived rows = duel ? props.market.outcomes : props.market.outcomes.slice(0, 3);

    const rowPath = (outcomeId: string): string => `${ detailPath }?outcome=${ encodeURIComponent(outcomeId) }`;

    // The two sides of a head-to-head read as competitors, not as yes/no: tinting one green
    // and the other red would claim one of them is the "no" answer, which is not the market.
    const SIDE = [
        'flex h-11 flex-1 items-center justify-center gap-1.5 rounded-control bg-brand-soft px-2 text-[14px] font-bold text-brand no-underline transition duration-200 hover-tint active:scale-[0.98]',
        'flex h-11 flex-1 items-center justify-center gap-1.5 rounded-control bg-gold-soft px-2 text-[14px] font-bold text-gold no-underline transition duration-200 hover-tint active:scale-[0.98]'
    ];

    <article
        class={ `${ cardClass({ interactive: true, animate: 'rise' }) } group flex h-full flex-col hover:shadow-lg` }
    >
        <div class="mb-3 flex items-start gap-3">
            <MarketAvatar image={ props.market.image } emoji={ props.market.emoji } size="md" />
            <Link
                to={ detailPath }
                class="min-h-[2.75em] min-w-0 flex-1 text-[15px] font-bold leading-snug text-text no-underline transition-colors duration-200 line-clamp-2 group-hover:text-brand"
            >
                { text(props.market.title) }
            </Link>
            <span class="flex shrink-0 items-center gap-1">
                <FavoriteButton marketId={ props.market.id } />
                <Show when={ props.market.trending }>
                    <Tooltip label={ t('home.trending') }>
                        <span
                            class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-soft text-brand"
                            role="img"
                            aria-label={ t('home.trending') }
                        >
                            <Icon name="flame" size={ 13 } />
                        </span>
                    </Tooltip>
                </Show>
                <Show when={ props.market.featured }>
                    <Tooltip label={ t('home.featured') }>
                        <span
                            class="flex h-6 w-6 items-center justify-center rounded-full bg-gold-soft text-gold"
                            role="img"
                            aria-label={ t('home.featured') }
                        >
                            <Icon name="sparkles" size={ 13 } />
                        </span>
                    </Tooltip>
                </Show>
                <Show when={ binary }>
                    <span class="relative ms-1 flex h-11 w-11 items-center justify-center">
                        <span class="absolute inset-0">
                            <ChanceRing share={ leadPrice(props.market) } size={ 44 } />
                        </span>
                        <span class="nums relative text-[11px] font-bold text-brand">
                            { formatOdds(leadPrice(props.market), lang(), oddsMode()) }
                        </span>
                    </span>
                </Show>
            </span>
        </div>

        <Show when={ binary }>
            <OutcomePair yesPrice={ leadPrice(props.market) } to={ detailPath } class="mb-3" />
        </Show>

        <Show when={ duel }>
            <div class="mb-3 flex flex-col gap-2">
                <For each={ rows } key={ (outcome) => outcome.id } let={ outcome } index={ index }>
                    <div class="flex items-center gap-2">
                        <Show when={ outcome.icon !== '' } fallback={ <span class="h-6 w-6 shrink-0 rounded-full bg-overlay"></span> }>
                            <span class="h-6 w-6 shrink-0 overflow-hidden rounded-full bg-overlay">
                                <img
                                    class="h-full w-full object-cover"
                                    src={ outcome.icon }
                                    alt=""
                                    loading="lazy"
                                />
                            </span>
                        </Show>
                        <span class="min-w-0 flex-1 truncate text-[13px] font-semibold">
                            { text(outcome.label) }
                        </span>
                        <span class="nums shrink-0 text-[13px] font-bold">{ outcomeOdds[index] ?? '-' }</span>
                    </div>
                </For>
                <div class="flex gap-2.5">
                    <For each={ rows } key={ (outcome) => outcome.id } let={ outcome } index={ index }>
                        <div class="contents">
                            <Link
                                to={ `${ rowPath(outcome.id) }&side=yes` }
                                class={ SIDE[index] ?? SIDE[0]! }
                            >
                                <span class="truncate">{ text(outcome.label) }</span>
                            </Link>
                        </div>
                    </For>
                </div>
            </div>
        </Show>

        <Show when={ !binary && !duel }>
            <div class="mb-3 flex flex-col gap-2">
                <For each={ rows } key={ (outcome) => outcome.id } let={ outcome } index={ index }>
                    <div class="contents">
                        <OutcomeRow
                            label={ text(outcome.label) }
                            icon={ outcome.icon }
                            odds={ outcomeOdds[index] ?? '' }
                            to={ rowPath(outcome.id) }
                            outcomeId={ outcome.id }
                        />
                    </div>
                </For>
                <Show when={ props.market.outcomes.length > 3 }>
                    <Link
                        to={ detailPath }
                        class="text-[12px] font-semibold text-faint no-underline hover:text-muted"
                    >
                        { t('common.seeMore') }
                    </Link>
                </Show>
            </div>
        </Show>

        <div class="mt-auto flex items-center justify-between gap-2 text-[12px] text-faint">
            <span class="nums flex min-w-0 items-center gap-1.5 truncate">
                <Icon name="volume" size={ 13 } />
                <span>{ formatVolume(props.market.volume, lang()) }</span>
                <span aria-hidden="true">·</span>
                <span class="truncate">{ categories.label(props.market.category) }</span>
            </span>
            { /* The countdown's slot, not an extra item: on a market that has ended the date
                 is a passed one, and the meta row holds three items precisely so it never
                 wraps. The tag says the same thing the date was there to say. */ }
            { ended ? (
                <span class="flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-overlay px-2 py-0.5 font-semibold text-muted">
                    <Icon name="circle-check" size={ 12 } />
                    { t('market.ended') }
                </span>
            ) : (
                <span class="nums flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full border border-line px-2 py-0.5">
                    <Icon name="clock" size={ 12 } />
                    { formatDateTimeShort(props.market.endsAt, lang(), calendarSystem()) }
                </span>
            ) }
        </div>
    </article>
}
