import type { Market, Outcome, Side } from '../../api.ts';

import { parseEther, formatEther } from 'viem';

import { chain } from '../../lib/chain.ts';
import { quoteBuy } from '../../lib/contracts.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { usePreferences } from '../../stores/preferences.store.ts';
import { useSession } from '../../stores/session.store.ts';
import { useOnchain } from '../../stores/onchain.store.ts';

import { formatMoney, formatOddsSet, formatFillPrice, formatShares } from '../../i18n/format.ts';

import Icon from '../../icons/icon.component.azeroth';

import Button from '../ui/button.component.azeroth';
import MarketAvatar from './market-avatar.component.azeroth';

// The trade ticket - one component, two homes: the desktop right-column panel and the
// mobile bottom sheet render exactly this. Signed out, the CTA becomes connect-wallet
// (via onConnect so the host can close its own sheet first - one surface, ever).
// Every market IS on-chain now: the address and outcome indices arrive on the wire, and
// Buy signs a real transaction through the connected wallet.
export default component TradeTicket(props: {
    market: Market;
    outcome: Outcome;
    side: Side;
    onSideChange: (side: Side) => void;
    onConnect?: () => void;
    onTraded?: () => void;
})
{
    const { t, lang, text } = useLocale();
    const { oddsMode } = usePreferences();
    const session = useSession();
    const onchain = useOnchain();

    state amount = 25;

    // Only a binary market HAS a NO token; a multi-outcome candidate can only be bought FOR,
    // so the side toggle disappears and the side is pinned to yes.
    derived sideOdds = formatOddsSet([props.outcome.price, 1 - props.outcome.price], lang(), oddsMode());

    derived binary = props.market.noIndex !== null;
    derived activeSide = binary ? props.side : 'yes';

    derived outcomeIndex = activeSide === 'no' && props.market.noIndex !== null
        ? props.market.noIndex
        : props.outcome.index;

    // The MARGINAL probability - what the next infinitesimal share costs. It is the honest
    // basis for an instant estimate and nothing more: it ignores both the trading fee and the
    // price impact of the order itself.
    derived price = activeSide === 'yes' ? props.outcome.price : 1 - props.outcome.price;
    derived estimate = price > 0 ? amount / price : 0;

    derived isPool = props.market.kind === 'pool';

    // ...so the number the trader actually sees comes from the MARKET'S OWN MATH. `calcBuy` is
    // the same function the transaction executes, so the quote and the fill cannot disagree.
    // Pool markets have no `calcBuy`/`buy` — they use `bet`/`impliedOdds` and split the pot.
    resource quote = (key: string) =>
    {
        const [, index = '0', value = '0'] = key.split('|');
        return quoteBuy(props.market.address as `0x${ string }`, Number(index), parseEther(value));
    } with { source: quoteKey };

    derived quoteKey = !isPool && amount > 0 && Number.isFinite(amount)
        ? `${ props.market.address }|${ outcomeIndex }|${ amount }`
        : false as const;

    derived quoted = quote.data();
    derived shares = isPool ? estimate : quoted === undefined ? estimate : Number(formatEther(quoted));

    // Winning shares redeem 1:1 (AMM) or pro-rata of the pool (Pool); estimate via amount/price keeps UI honest for both.
    derived payout = shares;

    // What the AMM's marginal price would have promised, minus what it will actually mint — pool has no slippage quote.
    derived cost = isPool || quoted === undefined ? 0 : Math.max(0, estimate - shares);
    derived effective = shares > 0 ? amount / shares : price;

    // A number input reports NaN when emptied, and NaN fails every comparison - so the
    // old `amount <= 0` guard let an empty field straight through to the wallet.
    derived tradeable = Number.isFinite(amount) && amount > 0 && !onchain.pending();

    const submit = async (): Promise<void> =>
    {
        const ok = isPool
            ? await onchain.bet(props.market.address as `0x${ string }`, outcomeIndex, amount)
            : await onchain.buy(props.market.address as `0x${ string }`, outcomeIndex, amount);
        if (ok)
        {
            props.onTraded?.();
        }
    };

    <div class="flex flex-col gap-4">
        <Show when={ props.market.outcomes.length > 1 }>
            <p class="flex items-center gap-2 text-[13px] font-semibold text-muted">
                <MarketAvatar image={ props.market.image } emoji={ props.market.emoji } size="sm" />
                { text(props.outcome.label) }
            </p>
        </Show>

        <Show when={ binary }>
            <div class="grid grid-cols-2 gap-2 rounded-control bg-overlay p-1" role="radiogroup" aria-label={ t('market.outcomes') }>
                <button
                    class={ activeSide === 'yes'
                        ? 'flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-[7px] bg-yes-soft text-[14px] font-bold text-yes'
                        : 'flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-[7px] text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text' }
                    type="button"
                    role="radio"
                    aria-checked={ activeSide === 'yes' ? 'true' : 'false' }
                    onClick={ () => props.onSideChange('yes') }
                >
                    <Icon name="circle-check" size={ 16 } />
                    <span>{ t('market.yes') }</span>
                    <span class="nums">{ sideOdds[0] }</span>
                </button>
                <button
                    class={ activeSide === 'no'
                        ? 'flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-[7px] bg-no-soft text-[14px] font-bold text-no'
                        : 'flex h-10 cursor-pointer items-center justify-center gap-1.5 rounded-[7px] text-[14px] font-semibold text-muted transition-colors duration-200 hover:text-text' }
                    type="button"
                    role="radio"
                    aria-checked={ activeSide === 'no' ? 'true' : 'false' }
                    onClick={ () => props.onSideChange('no') }
                >
                    <Icon name="circle-x" size={ 16 } />
                    <span>{ t('market.no') }</span>
                    <span class="nums">{ sideOdds[1] }</span>
                </button>
            </div>
        </Show>

        <div>
            <label class="mb-1.5 block text-[13px] font-semibold text-muted" for="trade-amount">{ t('market.amount') }</label>
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 start-3.5 flex items-center text-[13px] font-semibold text-muted" aria-hidden="true">{ chain.nativeCurrency.symbol }</span>
                <input
                    id="trade-amount"
                    class="nums h-12 w-full rounded-control border border-line bg-raised ps-12 pe-3.5 text-lg font-bold text-text transition-colors duration-200 focus:border-brand focus:outline-none"
                    type="number"
                    inputmode="decimal"
                    min="0"
                    bind:value={ amount }
                />
            </div>
            <div class="mt-2 flex gap-2">
                <button class="h-9 flex-1 cursor-pointer rounded-control bg-overlay text-[13px] font-semibold text-muted transition duration-200 hover:text-text active:scale-95" type="button" onClick={ () => amount = amount + 10 }>+10</button>
                <button class="h-9 flex-1 cursor-pointer rounded-control bg-overlay text-[13px] font-semibold text-muted transition duration-200 hover:text-text active:scale-95" type="button" onClick={ () => amount = amount + 50 }>+50</button>
                <button class="h-9 flex-1 cursor-pointer rounded-control bg-overlay text-[13px] font-semibold text-muted transition duration-200 hover:text-text active:scale-95" type="button" onClick={ () => amount = amount + 100 }>+100</button>
                <button class="h-9 flex-1 cursor-pointer rounded-control bg-overlay text-[13px] font-semibold text-muted transition duration-200 hover:text-text active:scale-95" type="button" onClick={ () => amount = amount + 500 }>+500</button>
            </div>
        </div>

        <dl class="flex flex-col gap-2 border-t border-line pt-3 text-[14px]">
            <div class="flex justify-between">
                <dt class="text-muted">{ t('market.pricePerShare') }</dt>
                <dd class="nums font-semibold">{ formatFillPrice(effective, lang()) }</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-muted">{ t('market.shares') }</dt>
                <dd class="nums font-semibold">{ formatShares(shares, lang()) }</dd>
            </div>
            <Show when={ cost > 0 }>
                <div class="flex justify-between text-[13px]">
                    <dt class="text-faint">{ t('market.feeImpact') }</dt>
                    <dd class="nums text-faint">−{ formatShares(cost, lang()) }</dd>
                </div>
            </Show>
            <div class="flex justify-between text-[16px]">
                <dt class="font-semibold">{ t('market.payoutIfRight') }</dt>
                <dd class="nums font-bold text-brand">{ formatMoney(payout, lang()) }</dd>
            </div>
        </dl>

        <Show
            when={ session.connected() }
            fallback={
                <Button variant="primary" size="lg" block icon="wallet" onClick={ () => props.onConnect?.() }>
                    { t('auth.title') }
                </Button>
            }
        >
            <Button
                variant={ activeSide === 'yes' ? 'primary' : 'danger' }
                size="lg"
                block
                disabled={ !tradeable }
                loading={ isPool ? onchain.busy(`bet:${ props.market.address }`) : onchain.busy(`buy:${ props.market.address }`) }
                onClick={ () => void submit() }
            >
                { isPool ? t('market.bet') : t('market.buy') }
            </Button>
        </Show>
        <p class="flex items-center gap-1.5 text-[12px] text-faint">
            <Icon name="verified" size={ 13 } />
            <span>{ t('chain.onchainMarket') }</span>
        </p>
    </div>
}
