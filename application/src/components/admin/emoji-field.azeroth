import { useLocale } from '../../stores/locale.store.ts';

// The quick picks. Any other emoji is typed or pasted into the slot after them - the OS emoji
// keyboard (Win+. on Windows, the emoji key on a phone) is a better picker than a list kept here.
const EMOJI = ['🔥', '₿', '⚽', '🏆', '🗳️', '🎬', '🚀', '📈', '📉', '🌍', '🧪', '💻', '🎮', '🏛️', '⚖️', '🎯'];

/** The LAST grapheme in the field: the avatar is one glyph wide, and an emoji typed after the
 *  one already there should replace it rather than queue behind it. */
function lastGrapheme(value: string): string
{
    return [...new Intl.Segmenter().segment(value.trim())].at(-1)?.segment ?? '';
}

export default component EmojiField(props: { value: string; onChange: (next: string) => void })
{
    const { t } = useLocale();

    /** What the typing slot shows: a pick already on the grid lights up there instead. */
    derived custom = EMOJI.includes(props.value) ? '' : props.value;

    const type = (event: Event): void =>
    {
        const field = event.target as HTMLInputElement;
        const next = lastGrapheme(field.value);
        // Written back by hand as well: typing the SAME emoji twice changes no state, so the
        // binding alone would leave both copies on screen.
        field.value = EMOJI.includes(next) ? '' : next;
        props.onChange(next);
    };

    <div>
        <p class="mb-1.5 text-[12px] font-semibold text-muted">{ t('admin.formEmoji') }</p>
        <div class="flex flex-wrap gap-1.5">
            <For each={ EMOJI } key={ (entry) => entry } let={ entry }>
                <button
                    class={
                        props.value === entry
                            ? 'flex h-10 w-10 cursor-pointer items-center justify-center rounded-control bg-brand-soft text-[19px] ring-1 ring-brand'
                            : 'flex h-10 w-10 cursor-pointer items-center justify-center rounded-control bg-overlay text-[19px] transition-colors duration-200 hover:bg-raised'
                    }
                    type="button"
                    aria-pressed={ props.value === entry }
                    onClick={ () => props.onChange(props.value === entry ? '' : entry) }
                >
                    { entry }
                </button>
            </For>
            <input
                class={
                    custom === ''
                        ? 'h-10 w-14 rounded-control border border-line bg-raised text-center text-[19px] text-text placeholder:text-faint transition-colors duration-200 focus:border-brand focus:outline-none'
                        : 'h-10 w-14 rounded-control border border-transparent bg-brand-soft text-center text-[19px] text-text ring-1 ring-brand focus:outline-none'
                }
                type="text"
                value={ custom }
                placeholder="+"
                aria-label={ t('admin.formEmoji') }
                onInput={ type }
            />
        </div>
    </div>
}
