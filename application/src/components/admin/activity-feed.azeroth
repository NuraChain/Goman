import { useLocale } from '../../stores/locale.store.ts';
import { useAdmin } from '../../stores/admin.store.ts';

import { formatMoney, formatFillPrice, formatShares, formatTimeAgo } from '../../i18n/format.ts';
import { shortAddress } from '../../lib/wallet.ts';

import Icon from '../../icons/icon.azeroth';

import Card from '../ui/card.azeroth';
import EmptyState from '../ui/empty-state.azeroth';
import Pagination from '../ui/pagination.azeroth';
import SkeletonList from '../ui/skeleton-list.azeroth';

// The chain's recent trades across every market, straight from the index, server-paged.
export default component ActivityFeed()
{
    const { t, lang } = useLocale();
    const admin = useAdmin();

    derived feed = admin.activity.data()?.rows ?? [];

    <Card>
        <h2 class="mb-3 text-lg font-bold tracking-tight">{ t('admin.feedTitle') }</h2>

        <Show when={ admin.activity.loading() && admin.activity.data() === undefined }>
            <SkeletonList count={ 4 } height="h-9" />
        </Show>

        <Show when={ admin.activity.data() !== undefined && feed.length === 0 }>
            <EmptyState icon="activity" title={ t('admin.feedEmpty') } />
        </Show>

        <Show when={ feed.length > 0 }>
            <div>
                <ul class="flex flex-col">
                    <For each={ feed } key={ (entry) => entry.id } let={ entry }>
                        <li
                            class="flex items-center gap-2.5 border-b border-line py-2.5 text-[12.5px] last:border-b-0"
                        >
                            <span class={ entry.action === 'buy' ? 'text-yes' : 'text-no' } aria-hidden="true">
                                <Icon name={ entry.action === 'buy' ? 'trending-up' : 'trending-down' } size={ 15 } />
                            </span>
                            <span class="min-w-0 flex-1 truncate">
                                <span class="nums latin-nums font-semibold" dir="ltr">
                                    { shortAddress(entry.user) }
                                </span>
                                <span class="text-muted">
                                    { ' ' }
                                    { entry.action === 'buy' ? t('market.bought') : t('market.sold') }{ ' ' }
                                </span>
                                <span class="nums">{ formatShares(entry.shares, lang()) }</span>
                                <span class="nums text-muted"> @ { formatFillPrice(entry.price, lang()) }</span>
                            </span>
                            <span class="nums shrink-0 text-muted">
                                { formatMoney(entry.shares * entry.price, lang(), { compact: true }) }
                            </span>
                            <span class="shrink-0 text-faint">{ formatTimeAgo(entry.at, lang()) }</span>
                        </li>
                    </For>
                </ul>
                <div class="mt-4">
                    <Pagination
                        page={ admin.activity.data()?.page ?? 1 }
                        pages={ admin.activity.data()?.pages ?? 1 }
                        onChange={ (next) => admin.setFeedPage(next) }
                    />
                </div>
            </div>
        </Show>
    </Card>
}
