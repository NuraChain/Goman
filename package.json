{
    "name": "goman",
    "version": "1.3.6",
    "private": true,
    "workspaces": [
        "application",
        "server"
    ],
    "type": "module",
    "scripts": {
        "dev": "npm run dev --workspace server",
        "check": "azeroth check && eslint .",
        "build": "azeroth build",
        "test": "azeroth test",
        "start": "npm start --workspace server",
        "service:stop": "bash scripts/service-stop.sh",
        "service:start": "bash scripts/service-start.sh",
        "service:status": "bash scripts/service-status.sh",
        "service:restart": "bash scripts/service-restart.sh",
        "service:install": "bash scripts/service-install.sh",
        "service:uninstall": "bash scripts/service-uninstall.sh",
        "service:deploy": "npm run build && npm run service:restart",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@azerothjs/cli": "^2.1.0",
        "@azerothjs/eslint-plugin": "^2.1.0",
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint": "^9.39.5"
    },
    "engines": {
        "node": ">=24"
    }
}
